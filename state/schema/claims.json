{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "claims.json",
  "title": "Active claims",
  "description": "state/claims.json — who currently holds what. Written by the Discord bot only. One claim per user, at most.",
  "type": "object",
  "additionalProperties": false,
  "required": ["claims"],
  "properties": {
    "claims": {
      "type": "array",
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["task_id", "discord_id", "claimed_at", "branch"],
        "properties": {
          "task_id": {
            "type": "string",
            "pattern": "^t-[0-9]{3}$"
          },
          "discord_id": {
            "type": "string",
            "pattern": "^[0-9]{17,20}$",
            "description": "Discord snowflake. Must appear in state/users.json."
          },
          "claimed_at": {
            "type": "string",
            "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?Z$",
            "description": "RFC3339 UTC. /board reports claim age from this."
          },
          "branch": {
            "type": "string",
            "pattern": "^task/t-[0-9]{3}$"
          },
          "thread_id": {
            "type": "string",
            "pattern": "^[0-9]{17,20}$",
            "description": "Discord thread opened for this claim, if any."
          }
        }
      }
    }
  }
}

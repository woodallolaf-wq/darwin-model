{
  "name": "@darwin/state",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Treats a GitHub repo as a datastore for the task table, claims and users.",
  "main": "./dist/index.js",
  "types": "./dist/index.d.ts",

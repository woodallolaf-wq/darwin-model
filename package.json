{
  "name": "darwin-model",
  "version": "0.0.0",
  "private": true,
  "description": "Repo-as-database experiment: a daily agent writes contracts with deliberately open decisions; humans implement them.",
  "engines": {
    "node": ">=22"
  },
  "scripts": {
    "validate:state": "node tools/validate-state.js",
    "test:glob": "node tools/validate-state.js --self-test",
    "test:smoke": "node --test \"tests/smoke/**/*.test.js\"",
    "typecheck": "npm run typecheck --workspaces --if-present",
    "build": "npm run build --workspaces --if-present",
    "test:unit": "npm run test --workspaces --if-present"
  },
  "workspaces": [
    "packages/*"
  ]
}

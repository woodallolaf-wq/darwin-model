# Copy to .env and fill in. .env is gitignored — never commit real values.
# See docs/discord-setup.md for where each of these comes from.

# --- Discord ---------------------------------------------------------------
# Bot tab -> Reset Token. Shown exactly once.
DISCORD_TOKEN=

# General Information -> Application ID.
DISCORD_APPLICATION_ID=

# Right-click the server name -> Copy Server ID.
# Slash commands registered to a guild appear instantly; global ones can take
# up to an hour to propagate, so develop against this.
DISCORD_GUILD_ID=

# Right-click each channel -> Copy Channel ID.
DISCORD_CHANNEL_START=
DISCORD_CHANNEL_CODE=
DISCORD_CHANNEL_MERGED=

# --- GitHub ----------------------------------------------------------------
# Fine-grained PAT scoped to the three project repos.
# Contents: read/write. Issues: read/write. Nothing else.
# This is the bot's own token — routines use the Claude GitHub App instead.
GITHUB_TOKEN=

# Repos the bot serves, comma-separated owner/name.
GITHUB_REPOS=woodallolaf-wq/darwin-model,woodallolaf-wq/wildplaces,woodallolaf-wq/nostia-landing-redesign

{
  "name": "@darwin/bot",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Discord surface for claiming tasks. Deterministic dispatcher: no LLM anywhere.",
  "main": "./dist/index.js",
  "scripts": {
    "build": "tsc -b tsconfig.json",
    "typecheck": "tsc -b tsconfig.json",
    "test": "node --test \"test/**/*.test.js\"",
    "register": "node --env-file=../../.env dist/register.js",
    "dev": "wrangler dev",
    "deploy": "wrangler deploy"
  },
  "dependencies": {
    "@darwin/state": "*",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.5",
    "wrangler": "^3.114.0"
  }
}

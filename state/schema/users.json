{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "users.json",
  "title": "Trusted users",
  "description": "state/users.json — the five trusted users, hardcoded. Anyone not in this file cannot claim a task. Edited by hand only; no agent writes this file.",
  "type": "object",
  "additionalProperties": false,
  "required": ["users"],
  "properties": {
    "users": {
      "type": "array",
      "minItems": 1,
      "maxItems": 5,
      "items": {
        "type": "object",
        "additionalProperties": false,
        "required": ["discord_id", "github_login"],
        "properties": {
          "discord_id": {
            "type": "string",
            "pattern": "^[0-9]{17,20}$",
            "description": "Discord snowflake. Enable Developer Mode in Discord, right-click the user, Copy User ID."
          },
          "github_login": {
            "type": "string",
            "pattern": "^[A-Za-z0-9](?:[A-Za-z0-9]|-(?=[A-Za-z0-9])){0,38}$",
            "description": "GitHub username, no @."
          },
          "note": {
            "type": "string",
            "description": "Free text, for your own reference."
          }
        }
      }
    }
  }
}

    "test": "node --test \"test/**/*.test.js\""
  },
  "dependencies": {
    "@octokit/rest": "^21.1.1",
    "zod": "^3.24.2"
  },
  "devDependencies": {
    "typescript": "^5.7.3",
    "@types/node": "^22.13.5"
  }
}
